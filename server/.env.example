# === BotZone Backend ENV ===
# Copy this to .env and fill real values - NEVER commit .env to GitHub!

# Server
PORT=3001
NODE_ENV=development
FRONTEND_URL=https://amogrotex.github.io
# For local dev: http://localhost:5173,http://localhost:3000,https://amogrotex.github.io,https://amogrotex.github.io/BotZone

# Database - MongoDB Atlas or local
# Get free cluster at https://cloud.mongodb.com
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/botzone?retryWrites=true&w=majority
# Or local: mongodb://localhost:27017/botzone

# Auth
JWT_SECRET=CHANGE_THIS_TO_A_RANDOM_64_CHAR_STRING_USE_OPENSSL_RAND_BASE64_32
JWT_EXPIRES_IN=7d

# Google OAuth (for backend verification)
GOOGLE_CLIENT_ID=876921769769-fcflfi7pius44qsvqb6fhev5mq2l8ife.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=PUT_YOUR_SECRET_HERE_AND_NEVER_SHARE_IT

# Encryption for protected files
# Generate with: openssl rand -hex 32
FILE_ENCRYPTION_KEY=CHANGE_THIS_TO_64_HEX_CHARS_FOR_AES_256_ENCRYPTION

# Uploads (these folders are gitignored - people who clone repo can't access files)
UPLOAD_DIR=./uploads
ENCRYPTED_DIR=./storage/encrypted
