# Frontend ENV - NEVER commit real secrets, use .env locally (gitignored)
# Google OAuth - get from https://console.cloud.google.com/apis/credentials
VITE_GOOGLE_CLIENT_ID=876921769769-fcflfi7pius44qsvqb6fhev5mq2l8ife.apps.googleusercontent.com

# Backend API - your deployed backend URL
# Local: http://localhost:3001/api
# Production: https://your-backend.onrender.com/api
VITE_API_URL=http://localhost:3001/api

# Note: VITE_ vars are baked into frontend at build time (public), but backend secrets stay in server/.env (private, gitignored)
